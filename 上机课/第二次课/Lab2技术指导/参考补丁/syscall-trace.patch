--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -6,6 +6,17 @@
 #include "spinlock.h"
 #include "proc.h"
 
+uint64
+sys_trace(void)
+{
+  int mask;
+
+  // In this 2024 branch argint() returns void, not a status code.
+  argint(0, &mask);
+  myproc()->trace_mask = (uint)mask;
+  return 0;
+}
