+void
+backtrace(void)
+{
+  uint64 fp = r_fp();
+  // fp can equal the end of the stack page. fp-1 selects that page.
+  uint64 low = PGROUNDDOWN(fp - 1);
+  uint64 high = low + PGSIZE;
+
+  printf("backtrace:\n");
+  while(fp >= low + 16 && fp <= high && (fp & 15) == 0){
+    uint64 ra = *(uint64 *)(fp - 8);
+    uint64 previous = *(uint64 *)(fp - 16);
+    printf("%p\n", (void *)ra);
+    // The stack grows down: callers must have a strictly larger fp.
+    if(previous <= fp || previous > high)
+      break;
+    fp = previous;
+  }
+}
+
 void
 panic(char *s)
 {
   pr.locking = 0;
   printf("panic: ");
   printf("%s\n", s);
+  backtrace();
   panicked = 1; // freeze uart output from other CPUs
   for(;;)
     ;
