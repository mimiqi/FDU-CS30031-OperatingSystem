diff --git a/kernel/trap.c b/kernel/trap.c
index d454a7d..c7c1e40 100644
--- a/kernel/trap.c
+++ b/kernel/trap.c
@@ -76,9 +76,20 @@ usertrap(void)
   if(killed(p))
     exit(-1);
 
-  // give up the CPU if this is a timer interrupt.
-  if(which_dev == 2)
+  // Count only timer interrupts that interrupted user-mode execution.
+  if(which_dev == 2){
+    if(p->alarm_interval > 0 && !p->alarm_active){
+      p->alarm_ticks++;
+      if(p->alarm_ticks >= p->alarm_interval){
+        p->alarm_saved = *p->trapframe;
+        p->alarm_active = 1;
+        p->alarm_ticks = 0;
+        p->trapframe->epc = p->alarm_handler;
+      }
+    }
+    // Preserve the original timer-driven scheduling behavior.
     yield();
+  }
 
   usertrapret();
 }
