diff --git a/kernel/sysproc.c b/kernel/sysproc.c
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -5,6 +5,41 @@
 #include "memlayout.h"
 #include "spinlock.h"
 #include "proc.h"
+
+uint64
+sys_sigalarm(void)
+{
+  int interval;
+  uint64 handler;
+  struct proc *p = myproc();
+
+  argint(0, &interval);
+  argaddr(1, &handler);
+  if(interval < 0)
+    return -1;
+
+  p->alarm_interval = interval;
+  p->alarm_handler = handler;
+  p->alarm_ticks = 0;
+  // Do not clear alarm_active or alarm_saved here: a handler may disable
+  // further alarms before calling sigreturn() to restore its context.
+  return 0;
+}
+
+uint64
+sys_sigreturn(void)
+{
+  struct proc *p = myproc();
+  if(!p->alarm_active)
+    return -1;
+
+  uint64 saved_a0 = p->alarm_saved.a0;
+  *p->trapframe = p->alarm_saved;
+  p->alarm_active = 0;
+  p->alarm_ticks = 0;
+  // syscall() writes this return value to a0, so preserve the original a0.
+  return saved_a0;
+}
 
 uint64
 sys_exit(void)
diff --git a/kernel/trap.c b/kernel/trap.c
--- a/kernel/trap.c
+++ b/kernel/trap.c
@@ -76,9 +76,20 @@
   if(killed(p))
     exit(-1);
 
-  // give up the CPU if this is a timer interrupt.
-  if(which_dev == 2)
+  // Count only timer interrupts that interrupted user-mode execution.
+  if(which_dev == 2){
+    if(p->alarm_interval > 0 && !p->alarm_active){
+      p->alarm_ticks++;
+      if(p->alarm_ticks >= p->alarm_interval){
+        p->alarm_saved = *p->trapframe;
+        p->alarm_active = 1;
+        p->alarm_ticks = 0;
+        p->trapframe->epc = p->alarm_handler;
+      }
+    }
+    // Preserve the original timer-driven scheduling behavior.
     yield();
+  }
 
   usertrapret();
 }
