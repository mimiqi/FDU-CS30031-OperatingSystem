+// Reset alarm state for a new/reused process or a newly exec'd image.
+void
+alarmreset(struct proc *p)
+{
+  p->alarm_interval = 0;
+  p->alarm_ticks = 0;
+  p->alarm_handler = 0;
+  p->alarm_active = 0;
+  memset(&p->alarm_saved, 0, sizeof(p->alarm_saved));
+}
